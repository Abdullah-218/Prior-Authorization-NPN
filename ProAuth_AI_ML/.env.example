# Same Postgres the Node backend uses — needed by policy-rag/ingest_cms_ncd.py
# (writes directly into tables Sequelize owns/migrates).
DATABASE_URL=

# LangGraph checkpointer (agent workflow/execution state) — a MongoDB Atlas
# connection string, database name included at the end of the path (e.g.
# .../proauth_langgraph). NOT the main application database — that's
# PostgreSQL, unchanged. Get this from Atlas: Database > Connect > Drivers.
MONGODB_URI=

# Groq API key(s), used by the policy/clinical/document/coverage-reasoning/
# companion agents (real tool-calling).
#
# GROQ_AGENT_API_KEY: single key, used directly if GROQ_API_KEYS is unset.
GROQ_AGENT_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# GROQ_API_KEYS (optional): comma-separated pool of keys — see
# groq_key_pool.py. When set, every agent call rotates through this pool
# instead of using GROQ_AGENT_API_KEY alone, and automatically moves to
# the next key when the current one hits Groq's rate limit. Leave unset to
# just use the single GROQ_AGENT_API_KEY above.
# GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three

# GROQ_KEY_RESET_TZ (optional): timezone the pool uses to decide "a new
# day started, reset all keys to available". Defaults to UTC — confirm
# the actual reset time for your Groq plan tier before changing this.
# GROQ_KEY_RESET_TZ=UTC
