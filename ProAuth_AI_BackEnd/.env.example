PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://proauth:proauth_dev_password@127.0.0.1:5435/proauth_ai
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Base URL of the Python triage service (ProAuth_AI_ML/policy-rag). Optional —
# defaults to http://localhost:8002 if unset.
# TRIAGE_SERVICE_URL=http://localhost:8002

# AES-256-GCM key for field-level encryption of clinical/decision columns
# (src/utils/fieldEncryption.js) — encrypts Authorization.clinical/treatment/
# previousTreatment/justification/currentMedications and TriageEvaluation.
# decision/clinicalEvidence/clinicalCriteriaEval/explanation/mlFeatures/diagnosis.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: provision via `copilot secret init --name DATA_ENCRYPTION_KEY`, same
# mechanism already used for JWT_SECRET.
DATA_ENCRYPTION_KEY=
